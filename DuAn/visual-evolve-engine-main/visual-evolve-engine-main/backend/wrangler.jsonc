{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duanbackup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "vars": {
    "ADMIN_EMAIL": "admin@namnguyen.local",
    "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duanbackup",
      "database_id": "4b300047-4186-4d29-b0c1-14724a42fde4",
      "migrations_dir": "migrations"
    }
  ]
}
