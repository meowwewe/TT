{
  "name": "duanbackup-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc",
    "start": "wrangler dev --ip 127.0.0.1 --config ./wrangler.jsonc",
    "deploy": "wrangler deploy --config ./wrangler.jsonc",
    "db:apply:local": "wrangler d1 migrations apply duanbackup-db --local --config ./wrangler.jsonc",
    "db:apply:remote": "wrangler d1 migrations apply duanbackup-db --remote --config ./wrangler.jsonc",
    "db:seed:local": "node scripts/import-json-to-d1.cjs --local",
    "db:seed:remote": "node scripts/import-json-to-d1.cjs --remote",
    "check": "node scripts/admin-check.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.30.0"
  }
}
